# Normalize line endings across platforms. Force LF in the working tree
# everywhere, not just in the repo: this is authored on Windows, and anything
# that ends up executing elsewhere -- a CI runner, a container, a host -- must
# not receive CRLF.
* text=auto eol=lf

# These execute or are parsed by tools that care, so they are stated
# explicitly rather than left to `text=auto` inference.
*.sh    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
.githooks/*  text eol=lf
